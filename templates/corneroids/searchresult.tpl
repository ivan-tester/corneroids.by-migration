<div style="float:left; width:270px;"><img src="{THEME}/img/user.png" alt="" style="padding-left:15px;" />{result-author}<img src="{THEME}/img/comm.png" style="padding-left:15px;" alt="" />{result-comments}</div>
<div style="float:right;">[edit]<img src="{THEME}/img/edit.png" title="Редактировать публикацию"  alt="" />[/edit]
[result-link]<img src="{THEME}/img/fullb.png" align="right" alt="Изучить полную версию новости" />[/result-link]</div></div><div class="clear"> </div>
</div><div class="cf3"> </div></div></div></dt>
[/fullresult]
