[searchposts]
[fullresult]
<dt><div class="cf2"><div class="cf"><div class="cfs"><div class="mainf"><b>[result-link]{result-title}[result-link]</b></div>
<div class="inmy"><img src="{THEME}/img/book.png" alt="" />{link-category}<img src="{THEME}/img/date.png" alt="" style="padding-left:15px;" />{result-date}</div>
