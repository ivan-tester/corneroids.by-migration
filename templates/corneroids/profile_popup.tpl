<table width="100%">
    <tr>
        <td width="110" style="padding:5px;">Полное имя:</td>
        <td>{fullname}&nbsp;</td>
        <td rowspan="5" valign="top" align="right"><img src="{foto}" border="0" /></td>
    </tr>
    <tr>
        <td style="padding:5px;">Группа:</td>
        <td>{status}</td>
    </tr>
    <tr>
        <td style="padding:5px;">Дата посещения:</td>
        <td>{lastdate} [online]<img src="{THEME}/images/online.gif" style="vertical-align: middle;" title="Пользователь Онлайн" alt="Пользователь Онлайн" />[/online][offline]<img src="{THEME}/images/offline.gif" style="vertical-align: middle;" title="Пользователь offline" alt="Пользователь offline" />[/offline]</td>
    </tr>
    <tr>
        <td style="padding:5px;">Дата регистрации:</td>
        <td>{registration}</td>
    </tr>
    <tr>
        <td style="padding:5px;">Публикаций:</td>
        <td>{news-num} [ {news} ]</td>
    </tr>
    <tr>
        <td style="padding:5px;">Комментариев:</td>
        <td>{comm-num} [ {comments} ]</td>
    </tr>
</table>