+	width: 0%;
+	font-size: 12px;
+	line-height: 20px;
+	color: white;
+	text-align: center;
+	background-color: #428bca;
+	-webkit-transition: width 0.6s ease;
+	transition: width 0.6s ease;
+	border-radius: 8px;
+	box-shadow: none;
+	height: 8px;
+}
+.progress-bar span {
+	position: absolute;
+	width: 1px;
+	height: 1px;
+	margin: -1px;
+	padding: 0;
+	overflow: hidden;
+	clip: rect(0 0 0 0);
+	border: 0;
+}
